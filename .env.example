# Copy to `.env` and fill in. `.env` is gitignored — never commit it.
#
#   cp .env.example .env
#   git check-ignore -v .env     # must print a .gitignore line. If it prints nothing, STOP.

# ─────────────────────────────────────────────────────────────────────────────
# LLM + embeddings
# ─────────────────────────────────────────────────────────────────────────────
# Swapping MODEL within Gemini = change these values only, no code.
# Swapping PROVIDER = these values plus one adapter file implementing
# complete() and embed(). Nothing outside that file knows which provider runs.
GENIE_LLM_PROVIDER=gemini

# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Use the exact model ids your AI Studio console lists — they change, and a
# wrong id fails at the first call with a 404 rather than silently degrading.
GENIE_LLM_MODEL=
GENIE_EMBED_MODEL=

# `auto` = call embed() once at boot, read len(vector), assert it matches the
# pgvector column. Prevents writing malformed vectors into a live index when
# someone changes the embedding model.
GENIE_EMBED_DIM=auto

# ─────────────────────────────────────────────────────────────────────────────
# AdGrid BFF — the read path
# ─────────────────────────────────────────────────────────────────────────────
# token = forward a user JWT (production shape, and what QA verification needs)
# admin = unauthenticated admin endpoints, merchant_id passed per request
GENIE_BFF_MODE=token

GENIE_BFF_BASE=https://ag-dashboard-bff.qa.adgrid.ai
GENIE_BFF_ADMIN_BASE=

# Read per-request with an mtime check, so replacing the file swaps the token
# with no restart. NOTE: QA tokens from adg-dashboard live 5 MINUTES, so this
# is for one-off verification runs, not for keeping a service up.
GENIE_BFF_TOKEN_FILE=./secrets/bff.jwt

# ─────────────────────────────────────────────────────────────────────────────
# pgvector — Genie's OWN database. See RAG.md: not shared with another product.
# ─────────────────────────────────────────────────────────────────────────────
GENIE_PG_DSN=postgresql://qa:PASSWORD@localhost:5435/genie_qa

# ─────────────────────────────────────────────────────────────────────────────
# Service
# ─────────────────────────────────────────────────────────────────────────────
# 9021 = ag-dashboard-bff, 9022 = ag-open-service, so Genie takes 9030.
GENIE_HOST=127.0.0.1
GENIE_PORT=9030
GENIE_LOG_LEVEL=info
