# Copy to `.env` and fill in. `.env` is gitignored — never commit it.
#
#   cp .env.example .env
#   git check-ignore -v .env     # must print a .gitignore line. If it prints nothing, STOP.

# ─────────────────────────────────────────────────────────────────────────────
# LLM + embeddings
# ─────────────────────────────────────────────────────────────────────────────
# Swapping MODEL within Gemini = change these values only, no code.
# Swapping PROVIDER = these values plus one adapter file implementing
# complete() and embed(). Nothing outside that file knows which provider runs.
GENIE_LLM_PROVIDER=gemini

# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Use the exact model ids your AI Studio console lists — they change, and a
# wrong id fails at the first call with a 404 rather than silently degrading.
# Cheapest text model this key can use (pricing page, 2026-10-19): $0.25 in /
# $1.50 out per 1M tokens, ~0.9 s measured. gemini-2.5-flash-lite is cheaper but
# returns 404 "no longer available to new users". Genie's model only routes
# tie-breaks and words given facts, so a lite model is enough.
GENIE_LLM_MODEL=gemini-3.1-flash-lite
# Hidden reasoning tokens per call: 0 turns it off (cheaper, faster). Leave it out for
# a model that rejects the setting (gemini-3.5-flash-lite does).
GENIE_LLM_THINKING_BUDGET=0
# Models that take a thinking LEVEL instead (Gemini 3.5: minimal|low|medium|high; minimal is
# the floor, thinking cannot be turned off there). Wins over the budget when set.
GENIE_LLM_THINKING_LEVEL=
# Who writes the sentence under a live card: template (code; cannot invent a figure
# or a screen; free; instant) or model (the LLM rewords it; number-checked).
GENIE_LIVE_WORDING=template
GENIE_EMBED_MODEL=gemini-embedding-2

# `auto` = call embed() once at boot, read len(vector), assert it matches the
# pgvector column. Prevents writing malformed vectors into a live index when
# someone changes the embedding model.
GENIE_EMBED_DIM=auto

# ─────────────────────────────────────────────────────────────────────────────
# AdGrid BFF — the read path
# ─────────────────────────────────────────────────────────────────────────────
# token = forward a user JWT (production shape, and what QA verification needs)
# admin = unauthenticated admin endpoints, merchant_id passed per request
GENIE_BFF_MODE=token

GENIE_BFF_BASE=https://ag-dashboard-bff.qa.adgrid.ai
GENIE_BFF_ADMIN_BASE=

# Read per-request with an mtime check, so replacing the file swaps the token
# with no restart. NOTE: QA tokens from adg-dashboard live 5 MINUTES, so this
# is for one-off verification runs, not for keeping a service up.
GENIE_BFF_TOKEN_FILE=./secrets/bff.jwt

# >>> FILL: the agency dashboard's x-portal-id. Copy it from the QA dashboard:
# DevTools > Network > any BFF request > Request Headers > x-portal-id.
# Every BFF call needs it; without it the BFF answers PORTAL_ID_REQUIRED.
GENIE_BFF_PORTAL_ID=
# Dev only: the refresh token, so Genie can renew the 5-minute access token itself.
GENIE_BFF_REFRESH_FILE=./secrets/bff-refresh.token

# ─────────────────────────────────────────────────────────────────────────────
# pgvector — Genie's OWN database. See RAG.md: not shared with another product.
# ─────────────────────────────────────────────────────────────────────────────
GENIE_PG_DSN=postgresql://qa:PASSWORD@localhost:5435/genie_qa

# ─────────────────────────────────────────────────────────────────────────────
# Service
# ─────────────────────────────────────────────────────────────────────────────
# 9021 = ag-dashboard-bff, 9022 = ag-open-service, so Genie takes 9030.
GENIE_HOST=127.0.0.1
GENIE_PORT=9030
GENIE_LOG_LEVEL=info
# local = a developer's machine: may read a QA token from secrets/ (dev only).
# qa / prod = deployed: ONLY the token the dashboard forwards with each request is
# used; secrets/ is never read, even if a file is present.
GENIE_ENV=local
